{
  "name": "woule",
  "version": "1.0.0",
  "private": true,
  "description": "Woulé — location de véhicules entre particuliers aux Antilles-Guyane",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "jose": "5.10.0",
    "leaflet": "1.9.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "5.0.0",
    "server-only": "^0.0.1",
    "stripe": "17.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "^5.0.5"
  }
}
