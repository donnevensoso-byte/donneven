# Base de données (SQLite en local ; passez à PostgreSQL en production, voir README)
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions : générez-en un avec `openssl rand -base64 32`
AUTH_SECRET="changez-moi-avec-une-longue-chaine-aleatoire"

# URL publique de l'application (liens de paiement, e-mails)
APP_URL="http://localhost:3000"

# Dossier de stockage des photos et documents envoyés
UPLOAD_DIR="./uploads"

# Paiement Stripe (optionnel) : sans clé, l'application fonctionne en mode démo
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
