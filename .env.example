# --- Obligatoire -------------------------------------------------------------
# Base PostgreSQL (Neon, Supabase, Railway, Render, Scaleway, ou docker compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zouti
# URL publique du site (utilisée dans les e-mails et les redirections de paiement)
APP_URL=http://localhost:3000

# --- Administration ----------------------------------------------------------
# E-mails qui reçoivent automatiquement le rôle administrateur (séparés par des virgules)
ADMIN_EMAILS=

# --- Identité légale (mentions légales, CGU, confidentialité) -----------------
# Obligatoire avant l'ouverture au public. Micro-entreprise : nom suivi de « EI ».
CONTACT_EMAIL=
LEGAL_PUBLISHER=
LEGAL_ADDRESS=
LEGAL_SIRET=
# ex. « Immatriculée au RNE » ou « RCS Cayenne » (facultatif)
LEGAL_REGISTRATION=
# Médiateur de la consommation : nom et site (adhésion obligatoire)
LEGAL_MEDIATOR=
# Facultatifs : statut, TVA et directeur de la publication ont une valeur par défaut
# LEGAL_STATUS=Entrepreneur individuel (micro-entreprise)
# LEGAL_VAT=TVA non applicable, article 293 B du CGI
# LEGAL_DIRECTOR=

# --- Sécurité ----------------------------------------------------------------
# Nombre de proxys devant l'application (hébergeur, nginx, Cloudflare…). Sert à lire
# la vraie adresse du visiteur dans X-Forwarded-For pour les limites anti-abus.
TRUSTED_PROXIES=1
# Secret des tâches planifiées : appelez GET /api/cron toutes les 15 min avec
# « Authorization: Bearer <CRON_SECRET> » (expirations, rappels, versements).
CRON_SECRET=

# --- E-mails (facultatif) ----------------------------------------------------
# Sans SMTP, les e-mails sont affichés dans les logs du serveur et les comptes
# sont considérés comme vérifiés. Avec SMTP, la vérification d'e-mail est exigée
# avant de publier ou de réserver.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Zouti <bonjour@zouti97.fr>"

# --- Paiement en ligne (facultatif, Stripe Connect) --------------------------
# Sans ces clés, les locations se règlent en main propre lors de la remise.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frais de service prélevés sur les paiements en ligne (en %)
SERVICE_FEE_PERCENT=10

# --- Carte (facultatif) ------------------------------------------------------
# Fournisseur de tuiles ; OpenStreetMap par défaut (usage modéré uniquement).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; contributeurs OpenStreetMap
